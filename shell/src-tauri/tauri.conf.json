{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MapleLegends Boss Timer",
  "version": "1.0.1",
  "identifier": "com.guoc.mlbosstimer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MapleLegends Boss Timer",
        "width": 520,
        "height": 640,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
